    {
      "parameters": {
        "jsCode": "const fb = $input.first().json.feedback;\nlet promptInstruction = '';\nif (!fb || fb.trim() === '') {\n    promptInstruction = 'You are an expert copywriter. The previous slogan \"' + $input.first().json.slogan + '\" lacked sufficient distinction or quality. Provide a totally distinct, creative alternative that differs greatly in style and tone without explicit feedback.';\n} else {\n    promptInstruction = 'You are an expert copywriter. The previous slogan \"' + $input.first().json.slogan + '\" received the following QA feedback: \"' + fb + '\". Please revise and fix the slogan based on this feedback strictly.';\n}\nreturn [{ json: { ...$input.first().json, llmPrompt: promptInstruction } }];"
      },
      "id": "b9a9f21a-49af-48ee-a323-363f31a8380b",
      "name": "Feedback Logic",
