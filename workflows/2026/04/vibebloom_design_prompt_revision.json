    {
      "parameters": {
        "jsCode": "const fb = $input.first().json.feedback;\nlet promptInstruction = '';\nif (!fb || fb.trim() === '') {\n    promptInstruction = 'You are a senior POD prompt strategist. The previous image prompt \"' + $input.first().json.design_prompt + '\" was rejected by QA without specific feedback. Provide a totally distinct, creative alternative that differs greatly in compositional focus or aesthetic approach without violating base requirements.';\n} else {\n    promptInstruction = 'You are a senior POD prompt strategist. The previous image prompt \"' + $input.first().json.design_prompt + '\" received the following QA feedback: \"' + fb + '\". Please revise and fix the image prompt based on this feedback strictly.';\n}\nreturn [{ json: { ...$input.first().json, llmPrompt: promptInstruction } }];"
      },
      "id": "43509dd7-1386-47c1-9c85-d07cee102e74",
      "name": "Feedback Logic",
