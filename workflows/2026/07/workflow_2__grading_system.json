    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": \"You are an expert academic evaluator. Grade the User's Answer strictly as \\\"Right\\\" or \\\"Wrong\\\" and provide a concise 1-2 sentence constructive correction.\\nFormat output strictly as JSON with key \\\"grade\\\" and \\\"feedback\\\".\\n\\nQuestion:\\n\" + {{ JSON.stringify($json[\"Question\"]) }} + \"\\n\\nUser's Answer:\\n\" + {{ JSON.stringify($json[\"User Answer\"]) }},\n  \"stream\": false,\n  \"format\": \"json\"\n}",
        "options": {}
      },
      "id": "be99230b-d3fe-4104-9f33-8c7c4ab94e2c",
      "name": "Ollama Grading HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        608,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseObj = JSON.parse($input.item.json.response);\nlet parsed = { grade: 'Wrong', feedback: 'Failed to process feedback.' };\nif (responseObj) {\n  parsed.grade = responseObj.grade || 'Wrong';\n  parsed.feedback = responseObj.feedback || 'Evaluated.';\n}\nreturn {\n  Question: $node[\"Filter Un-Graded Answers\"].json[\"Question\"],\n  User_Answer: $node[\"Filter Un-Graded Answers\"].json[\"User Answer\"],\n  Grade: parsed.grade,\n  Feedback: parsed.feedback,\n  Source_Doc: $node[\"Filter Un-Graded Answers\"].json[\"Source Doc/Page\"]\n};"
      },
      "id": "02fd8c27-3aee-46d3-b2a9-fcf3ff427c4b",
      "name": "Parse Grade Output",
      "type": "n8n-nodes-base.code",
