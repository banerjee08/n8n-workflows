      "name": "Safely Abort1",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        5584,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseText = $input.item.json.response || '';\nlet items = [];\ntry {\n  const parsed = JSON.parse(responseText);\n  items = parsed.questions || parsed;\n} catch (e) {}\nif (!items || items.length === 0) {\n  return [{\n    Date: new Date().toISOString().split('T')[0],\n    Question: \"⚠️ MANUAL REVIEW REQUIRED: Malformed output.\",\n    User_Answer: \"N/A\",\n    Status: \"Review Needed\",\n    Source_Doc: $node[\"Resilient Slice1\"].json.file_name,\n    Source_Page: `${$node[\"Resilient Slice1\"].json.current_page}`\n  }];\n}\nreturn items.map(q => ({\n  Date: new Date().toISOString().split('T')[0],\n  Question: q.question_text || q.question,\n  User_Answer: \"\",\n  Status: \"Pending\",\n  Source_Doc: $node[\"Resilient Slice1\"].json.file_name,\n  Source_Page: `${$node[\"Resilient Slice1\"].json.current_page}-${$node[\"Resilient Slice1\"].json.next_page}`\n}));"
      },
