    {
      "parameters": {
        "jsCode": "const text = $input.item.json.text || '';\nconst currentPage = parseInt($node[\"Check Current Doc Status1\"]?.json?.current_page || $node[\"Get Next Pending Doc1\"]?.json?.current_page || $node[\"Loop Back to First Doc2\"]?.json?.current_page || 1);\nconst charsPerPage = 1500;\nconst startChar = (currentPage - 1) * charsPerPage * 35;\nlet endChar = currentPage * charsPerPage * 35;\nlet isEof = false;\nif (startChar >= text.length) isEof = true;\nif (endChar >= text.length) { endChar = text.length; isEof = true; }\nreturn {\n  text_chunk: text.substring(startChar, endChar),\n  current_page: currentPage,\n  next_page: isEof ? currentPage : currentPage + 35,\n  is_eof: isEof,\n  file_name: $node[\"Check Current Doc Status1\"]?.json?.file_name || $node[\"Get Next Pending Doc1\"]?.json?.file_name || $node[\"Loop Back to First Doc2\"]?.json?.file_name,\n  google_file_id: $node[\"Check Current Doc Status1\"]?.json?.google_file_id || $node[\"Get Next Pending Doc1\"]?.json?.google_file_id || $node[\"Loop Back to First Doc2\"]?.json?.google_file_id\n};"
      },
      "id": "da9a68a8-733d-4f53-b99d-ebd5c4c5112c",
      "name": "Resilient Slice1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4912,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {}
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama3\",\n  \"prompt\": \"You are an expert interviewer. Generate exactly 10 questions of varying answer lengths based strictly on the text. Return strictly as a JSON object with a single array \\\"questions\\\" containing objects with keys \\\"question_text\\\" and \\\"answer_type\\\".\\n\\nSource Text:\\n\" + {{ JSON.stringify($json.text_chunk) }},\n  \"stream\": false,\n  \"format\": \"json\"\n}",
        "options": {}
      },
