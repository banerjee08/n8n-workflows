      "parameters": {
        "jsCode": "const newItems = [];\nfor (const item of $input.all()) {\n  try {\n    let outputText = item.json.output || item.json.text || '';\n    if (outputText.includes('```json')) {\n      outputText = outputText.split('```json')[1].split('```')[0];\n    }\n    const prompts = JSON.parse(outputText.trim());\n    for (const p of prompts) {\n      newItems.push({\n        json: {\n          ...item.json,\n          design_prompt: p.design_prompt\n        }\n      });\n    }\n  } catch(e) {\n    newItems.push({ json: { ...item.json, error: 'Failed to process AI array', raw_output: item.json }});\n  }\n}\nreturn newItems;"
