    {
      "parameters": {
        "jsCode": "const newItems = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const keys = Object.keys(row);\n  for (const key of keys) {\n    if (row[key] && row[key].toString().toLowerCase() === 'yes') {\n      const brandName = key;\n      const monthValue = row['month'] || row['Month'] || '';\n      const dateValue = row['date'] || row['Date'] || '';\n      const eventValue = row['event/celebration'] || row['Event/Celebration'] || '';\n      \n      let productRec = '';\n      const allProductRecs = row['mid_tier_product_recommendations'] || row['Mid_tier_product_recommendations'] || '';\n      if (allProductRecs) {\n        const parts = allProductRecs.toString().split(';');\n        for (const part of parts) {\n          if (part.trim().toLowerCase().startsWith(brandName.toLowerCase() + ':')) {\n            productRec = part.trim().substring(brandName.length + 1).trim();\n            break;\n          }\n        }\n      }\n\n      newItems.push({\n        json: {\n          ...row,\n          month: monthValue,\n          date: dateValue,\n          brand: brandName,\n          event: eventValue,\n          mid_tier_product_recommendation: productRec\n        }\n      });\n    }\n  }\n}\nreturn newItems;"
      },
