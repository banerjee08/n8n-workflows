    {
      "parameters": {
        "jsCode": "const newItems = [];\nlet idx = 0;\nfor (const item of $input.all()) {\n  try {\n    let outputText = item.json.output || item.json.text || '';\n    if (outputText.includes('```json')) {\n      outputText = outputText.split('```json')[1].split('```')[0];\n    } else if (outputText.includes('```')) {\n      outputText = outputText.split('```')[1].split('```')[0];\n    } else {\n      const match = outputText.match(/\\[\\s*\\{[\\s\\S]*?\\}\\s*\\]/);\n      if (match) outputText = match[0];\n    }\n    \n    let parsed = [];\n    try {\n      parsed = JSON.parse(outputText.trim());\n    } catch (e) {\n      if (outputText.trim().startsWith('[')) {\n        parsed = JSON.parse(outputText.trim() + ']');\n      }\n    }\n    \n    let slogans = [];\n    if (Array.isArray(parsed)) {\n      const slogansObj = parsed.find(obj => obj.slogans && Array.isArray(obj.slogans));\n      if (slogansObj) slogans = slogansObj.slogans;\n    } else if (parsed.slogans && Array.isArray(parsed.slogans)) {\n      slogans = parsed.slogans;\n    }\n    \n    for (const slogan of slogans) {\n      if (!slogan) continue;\n      newItems.push({\n        json: Object.assign({}, item.json, { slogan_idea: slogan }),\n        pairedItem: { item: idx }\n      });\n    }\n  } catch(e) {\n    newItems.push({ \n      json: Object.assign({}, item.json, { error: 'Failed to process AI array', raw_output: item.json }),\n      pairedItem: { item: idx }\n    });\n  }\n  idx++;\n}\nreturn newItems;"
      },
