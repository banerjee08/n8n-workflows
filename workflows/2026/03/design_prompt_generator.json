      ],
      "id": "64939bcd-086a-4b6f-b300-9236e77b9f07",
      "webhookId": "24324ae8-03b6-4ca7-b0a9-c0b4bfea9ad5"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{'You are an expert Image Prompt Engineer for Print On Demand (POD) apparel. Your task is to write a highly detailed visual description that will be fed into an AI image generator (like Midjourney or FLUX.1) to create a t-shirt graphic.\\n\\nConcept Details:\\nBrand: ' + ($json.brand || $json.Brand || '') + '\\nEvent: ' + ($json.event || '') + '\\nSlogan: ' + ($json['Slogan Idea'] || $json.slogan || '') + '\\nBrand Positioning: ' + ($json.brand_positioning || '') + '\\nVoice & Tone: ' + ($json.brand_voice_tone || '') + '\\nTypography To Consider: ' + ($json.typography_hierarchy || '') + '\\nColors To Consider: ' + ($json.primary_color_palette || '') + '\\n\\nDesign Requirements to include in the visual description:\\n- Background/Margins: Must specify a transparent or null color background. Leave comfortable margins around the design edge (about 1–2\" from seam/neckline).\\n- Resolution & Quality: The generated image must be exactly 1024x1024 px natively, but designed so that it can be easily scalable to 4500x5400 px at 300 DPI for full-front chest-area coverage. Do not warp or stretch square art into a rectangle.\\n- Colors: Use RGB colors strictly. Palettes must be simple and harmonious. Do NOT use too many colors. Apply the Primary Color Palette in a subtle way.\\n- Text: Must include the slogan cleanly and prominently without distortion. Use legible, high-contrast fonts (avoid overly thin or scripty fonts). Keep text large enough to be readable from a few feet away (min 1-1.5\" height).\\n- Composition: Minimalistic aesthetic, balanced negative space. Do not cram details into a tiny box.\\n- Originality: Inspired but highly original, free from copyright infringement.\\n\\nCRITICAL INSTRUCTION: Write ONLY the final image generation prompt. Start your prompt exactly with \"A stylized illustration of...\" or \"A high quality t-shirt design graphic featuring...\". Describe the visual elements, the style, and the text layout in detail. DO NOT output conversational filler like \"Here is the prompt\" or repeat these instructions. Do NOT summarize the prompt details back. Do not use quotes.'}}",
        "options": {}
      },
