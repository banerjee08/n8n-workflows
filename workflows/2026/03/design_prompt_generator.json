    {
      "parameters": {
        "jsCode": "const newItems = [];\nfor (const item of $input.all()) {\n  let outputText = item.json.output || item.json.text || '';\n  \n  // Remove any deepseek-r1 generated <think> tags completely\n  outputText = outputText.replace(/<think>[\\s\\S]*?<\\/think>/gi, '').trim();\n  \n  // Strip any conversational filler preceding the actual prompt\n  let startIdx = outputText.indexOf('A stylized illustration of');\n  if (startIdx === -1) startIdx = outputText.indexOf('A high quality t-shirt design graphic featuring');\n  if (startIdx !== -1) {\n    outputText = outputText.substring(startIdx);\n  }\n  \n  // Remove leading/trailing quotes sometimes added by LLM\n  outputText = outputText.replace(/^[\"']|[\"']$/g, '').trim();\n  // Remove bold markdown tags if LLM outputs **Design Prompt:** \n  outputText = outputText.replace(/\\*\\*Design Prompt:\\*\\*\\s*/i, '').trim();\n  \n  const loopItem = $('Loop').first().json;\n  \n  newItems.push({\n    json: {\n      month: loopItem.month || '',\n      date: loopItem.date || '',\n      event: loopItem.event || '',\n      brand: loopItem.Brand || loopItem.brand || '',\n      product: loopItem.product || 't-shirt',\n      slogan: loopItem['Slogan Idea'] || loopItem.slogan || '',\n      design_prompt: outputText,\n      status: 'Ready for Review',\n      feedback: ''\n    }\n  });\n}\nreturn newItems;"
      },
