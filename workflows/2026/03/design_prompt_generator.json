    {
      "parameters": {
        "jsCode": "const brandGuidelinesRows = $input.all();\nconst loopItemJson = $('Loop').first().json || $node['Loop'].json;\n\nconst brandName = (loopItemJson.brand || loopItemJson.Brand || '').trim();\nlet brandPositioning = '';\nlet brandVoiceTone = '';\nlet typographyHierarchy = '';\nlet primaryColorPalette = '';\n\nif (brandName) {\n  const targetColumn = Object.keys(brandGuidelinesRows[0]?.json || {}).find(col => \n      col.toLowerCase().includes(brandName.toLowerCase()) && col.toLowerCase().includes('short desc')\n  ) || brandName + \" - Short Desc\";\n\n  for (const row of brandGuidelinesRows) {\n    const rowValues = Object.values(row.json).map(v => String(v).toLowerCase());\n    if (rowValues.includes('brand positioning') || rowValues.includes('brand positioning:')) {\n       brandPositioning = row.json[targetColumn] || '';\n    }\n    if (rowValues.includes('brand voice and tone') || rowValues.includes('brand voice & tone') || rowValues.includes('brand voice and tone:')) {\n       brandVoiceTone = row.json[targetColumn] || '';\n    }\n    if (rowValues.includes('typography hierarchy') || rowValues.includes('typography hierarchy:')) {\n       typographyHierarchy = row.json[targetColumn] || '';\n    }\n    if (rowValues.includes('primary color palette') || rowValues.includes('primary color palette:')) {\n       primaryColorPalette = row.json[targetColumn] || '';\n    }\n  }\n}\n\nreturn [{\n  json: {\n    ...loopItemJson,\n    brand_positioning: brandPositioning,\n    brand_voice_tone: brandVoiceTone,\n    typography_hierarchy: typographyHierarchy,\n    primary_color_palette: primaryColorPalette\n  }\n}];"
      },
      "name": "Prepare LLM Prompt",
      "type": "n8n-nodes-base.code",
