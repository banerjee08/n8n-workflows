    {
      "id": "code-daily-summary",
      "name": "5. Summarize Daily 5 Queue & Deduplicated Skills",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        620
      ],
      "parameters": {
        "jsCode": "\nconst queueValues = ($('3. Read Nightly Scrape Queue').first().json.values || []).slice(1);\nconst skillsValues = ($('4. Read Master Resume Skills Tab').first().json.values || []).slice(1);\nconst completedCourses = queueValues.filter(r => r && r.length >= 7 && (r[6] === 'Completed' || r[6] === 'Done'));\nconst next5Queued = queueValues.filter(r => r && r.length >= 7 && r[6] === 'Queued').slice(0, 5);\n\nreturn [{\n  json: {\n    status: 'active',\n    activeUntil: '2027-02-02',\n    dailyBatchSize: 5,\n    completedCoursesCount: completedCourses.length,\n    currentUniqueSkillsCount: skillsValues.filter(r => r && r[1]).length,\n    next5QueuedIds: next5Queued.map(r => r[0]),\n    next5QueuedNames: next5Queued.map(r => r[4])\n  }\n}];\n"
      }
    }
