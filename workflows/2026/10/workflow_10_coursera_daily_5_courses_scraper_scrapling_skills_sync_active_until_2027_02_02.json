      "id": "code-router",
      "name": "1. Parse Action & Active-Until-2027-02-02 Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ],
      "parameters": {
        "jsCode": "\nconst raw = $input.first() ? $input.first().json : {};\nconst body = raw.body || raw;\nconst now = new Date();\nconst cutoff = new Date('2027-02-02T23:59:59+05:30');\nconst action = body.action || 'daily_sync';\nconst dailyCourseLimit = Number(body.dailyCourseLimit || 5);\n\nif (now > cutoff && action === 'daily_sync' && !body.force) {\n  return [{\n    json: {\n      action: 'expired',\n      activeUntil: '2027-02-02',\n      now: now.toISOString(),\n      message: 'Schedule reached end date 2027-02-02.'\n    }\n  }];\n}\n\nconst safeName = (body.name || '').replace(/'/g, \"\\\\'\");\nconst q = `name = '${safeName}' and '${body.parentId || 'root'}' in parents and mimeType = '${body.mimeType || 'application/vnd.google-apps.folder'}' and 'me' in owners and trashed = false`;\n\nreturn [{\n  json: {\n    action,\n    dailyCourseLimit,\n    activeUntil: '2027-02-02',\n    spreadsheetId: body.spreadsheetId || 'YOUR_GOOGLE_DOC_OR_SHEET_ID',\n    range: body.range || \"'2. Nightly Scrape Queue (4-5/Night)'!A1:I150\",\n    valueRenderOption: body.valueRenderOption || 'FORMULA',\n    clearRange: body.clearRange || '',\n    writeRange: body.writeRange || '',\n    values: body.values || [],\n    name: body.name || '',\n    parentId: body.parentId || '',\n    mimeType: body.mimeType || 'application/vnd.google-apps.folder',\n    driveSearchQ: q\n  }\n}];\n"
      }
    },
