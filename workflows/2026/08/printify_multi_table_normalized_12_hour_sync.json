    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst blueprintsList = [];\n\nfor (const item of items) {\n  // Access the JSON data directly from each item element\n  const data = item.json;\n  \n  if (data && (data.id || data.blueprint_id)) {\n    blueprintsList.push({\n      json: {\n        \"Blueprint ID\": data.id || data.blueprint_id,\n        \"Product Title\": data.title || \"\",\n        \"Description\": data.description || \"Not available\",\n        \"Brand\": data.brand || \"\",\n        \"Model\": data.model || \"\",\n        \"Images\": JSON.stringify(data.images || []),\n        \"Last Updated\": new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn blueprintsList;"
      },
