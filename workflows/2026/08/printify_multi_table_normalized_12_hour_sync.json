    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst variantRows = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const variants = data.variants || [];\n  \n  // Safely extract IDs from current context or parent nodes\n  const blueprintId = item.json[\"Blueprint ID\"] || data.blueprint_id || \"\";\n  const providerId = item.json[\"Provider ID\"] || data.print_provider_id || \"\";\n  const providerName = item.json[\"Provider Name\"] || \"Unknown\";\n  \n  if (!Array.isArray(variants)) continue;\n\n  for (const variant of variants) {\n    const variantId = variant.id;\n    const variantName = variant.title || \"Unknown\";\n    const color = variant.options?.color || \"N/A\";\n    const size = variant.options?.size || \"N/A\";\n    \n    const placeholders = variant.placeholders || [];\n    \n    if (placeholders.length === 0) {\n      variantRows.push({\n        json: {\n          \"Blueprint ID\": blueprintId,\n          \"Provider ID\": providerId,\n          \"Provider Name\": providerName,\n          \"Variant ID\": variantId,\n          \"Variant Name\": variantName,\n          \"Color\": color,\n          \"Size\": size,\n          \"Placement Position\": \"None\",\n          \"Printing Method\": \"N/A\",\n          \"Puppeteer Width\": \"N/A\",\n          \"Puppeteer Height\": \"N/A\",\n          \"Last Updated\": new Date().toISOString()\n        }\n      });\n    } else {\n      for (const ph of placeholders) {\n        variantRows.push({\n          json: {\n            \"Blueprint ID\": blueprintId,\n            \"Provider ID\": providerId,\n            \"Provider Name\": providerName,\n            \"Variant ID\": variantId,\n            \"Variant Name\": variantName,\n            \"Color\": color,\n            \"Size\": size,\n            \"Placement Position\": ph.position || \"unknown\",\n            \"Printing Method\": ph.decoration_method || \"N/A\",\n            \"Puppeteer Width\": ph.width || \"N/A\",\n            \"Puppeteer Height\": ph.height || \"N/A\",\n            \"Last Updated\": new Date().toISOString()\n          }\n        });\n      }\n    }\n  }\n}\n\nreturn variantRows;"
      },
      "name": "Format Variants",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3808,
        192
      ],
      "id": "34e0b7c8-c660-4949-96b1-e294dbc49a22",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst formattedProviders = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const provider = items[i].json;\n\n  // 1. Get the parent Blueprint ID via paired item matching\n  const parentBlueprint = $(\"Upsert Blueprints Tab\").itemMatching(i)?.json;\n  const blueprintId = parentBlueprint ? parentBlueprint[\"Blueprint ID\"] : null;\n\n  // 2. Format decoration_methods array to a comma-separated string\n  let printMethodStr = \"\";\n  if (Array.isArray(provider.decoration_methods)) {\n    printMethodStr = provider.decoration_methods.join(\", \");\n  } else if (typeof provider.decoration_methods === \"string\") {\n    printMethodStr = provider.decoration_methods;\n  }\n\n  // 3. Push the clean row structure\n  if (provider && provider.id) {\n    formattedProviders.push({\n      json: {\n        \"Blueprint ID\": blueprintId,\n        \"Provider ID\": provider.id,\n        \"Provider Name\": provider.title || \"Unknown\",\n        \"Print Method\": printMethodStr,\n        \"Last Updated\": new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn formattedProviders;"
      },
